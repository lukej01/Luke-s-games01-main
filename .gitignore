# dependencies
/node_modules

# local Node.js downloads (once committed by accident: 140 MB of a macOS build)
/.tmp_node/

# next.js build cache (never commit)
/.next/

# build output dirs (intermediate - contents are copied to root after build)
/out/
/docs/
/build

# misc
.DS_Store
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env*

# vercel
.vercel

# typescript incremental
*.tsbuildinfo
